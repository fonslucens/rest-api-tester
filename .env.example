# Copy this file to .env (or run: npm run setup). Never commit your real .env file.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# MongoDB Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Local MongoDB example:  mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017

# At least 32 random characters. `npm run setup` generates one for you.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Allows collection-wide DELETE requests (DELETE /api/<resource>).
# Keep false unless you are testing with throwaway data.
ALLOW_BULK_DELETE=false
