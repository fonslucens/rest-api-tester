                  "const body = pm.response.json();",
                  "pm.test(\"Returns the new user\", () => pm.expect(body.user.email).to.eql(pm.collectionVariables.get(\"email\")));",
                  "pm.test(\"Password is never returned\", () => { pm.expect(body.user).to.not.have.property(\"hashed_password\"); pm.expect(body.user).to.not.have.property(\"salt\"); });",
