{
  "name": "rest-api-tester",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API testing project: CRUD, HTTP status codes, JSON validation and Bearer token (JWT) authentication for a Node.js/Express + MongoDB API.",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node server.js",
    "start:memory": "node scripts/start-memory.js",
    "dev": "nodemon --watch server --watch config server.js",
    "test": "node --test --test-concurrency=1 tests/"
  },
  "dependencies": {
    "body-parser": "^2.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}
